+class SecretRedactionFilter(logging.Filter):
+    """Defense-in-depth redaction for accidental credential logging.
+
+    Replaces values of credential-looking environment variables plus common
+    key shapes before a record reaches any handler (console or file).
+    """
+
+    _PATTERNS = (
